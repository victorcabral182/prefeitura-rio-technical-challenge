generator client {
  provider            = "prisma-client"
  output              = "../src/generated/prisma"
  moduleFormat        = "esm"
  importFileExtension = "js"
}

datasource db {
  provider = "mysql"
}

enum TipoUsuario {
  passageiro
  motorista
}

enum StatusCorrida {
  solicitada
  aceita
  em_andamento
  finalizada
}

// IDs em UUID v7: ordenado pelo tempo, então os inserts entram no fim do índice
// clusterizado do InnoDB em vez de espalhar páginas como o v4.
model Usuario {
  id           String      @id @default(uuid(7)) @db.Char(36)
  nome         String      @db.VarChar(100)
  email        String      @unique @db.VarChar(255)
  senhaHash    String      @map("senha_hash") @db.VarChar(255)
  tipo         TipoUsuario
  criadoEm     DateTime    @default(now()) @map("criado_em")
  atualizadoEm DateTime    @updatedAt @map("atualizado_em")

  corridasComoPassageiro Corrida[] @relation("passageiro")
  corridasComoMotorista  Corrida[] @relation("motorista")
  refreshTokens          RefreshToken[]

  @@map("usuarios")
}

model Corrida {
  id           String        @id @default(uuid(7)) @db.Char(36)
  origem       String        @db.VarChar(255)
  destino      String        @db.VarChar(255)
  status       StatusCorrida @default(solicitada)
  passageiroId String        @map("passageiro_id") @db.Char(36)
  // Preenchido quando um motorista aceita a corrida.
  motoristaId  String?       @map("motorista_id") @db.Char(36)
  // Incrementa a cada mudança: vai nos eventos para o worker descartar evento
  // velho, e o UPDATE condicional nela impede duas mudanças simultâneas.
  versao       Int           @default(1)
  // Idempotency-Key do POST e SHA-256 do corpo: reenvio com a mesma chave
  // devolve a mesma corrida; mesma chave com outro corpo é recusada.
  chaveIdempotencia String   @map("chave_idempotencia") @db.VarChar(255)
  hashIdempotencia  String   @map("hash_idempotencia") @db.Char(64)
  criadaEm     DateTime      @default(now()) @map("criada_em")
  atualizadaEm DateTime      @updatedAt @map("atualizada_em")

  passageiro Usuario  @relation("passageiro", fields: [passageiroId], references: [id])
  motorista  Usuario? @relation("motorista", fields: [motoristaId], references: [id])

  // A chave é única por passageiro: dois POSTs simultâneos com a mesma chave
  // esbarram aqui mesmo que os dois passem pela checagem da aplicação.
  @@unique([passageiroId, chaveIdempotencia])
  @@map("corridas")
}

// Outbox transacional: o evento é gravado na mesma transação da corrida e um
// relay publica no RabbitMQ depois. Sem isso, a API poderia gravar a corrida e
// cair antes de publicar (evento perdido), ou publicar e falhar no commit.
model OutboxEvento {
  // Vira o eventId da mensagem: o worker deduplica por ele.
  id          String    @id @default(uuid(7)) @db.Char(36)
  tipo        String    @db.VarChar(64)
  payload     Json
  // Contexto da requisição de origem (correlation_id, depois traceparent), que o
  // relay repassa como headers AMQP: ele publica fora da requisição.
  headers     Json?
  criadoEm    DateTime  @default(now()) @map("criado_em")
  publicadoEm DateTime? @map("publicado_em")

  @@index([publicadoEm])
  @@map("outbox_eventos")
}

// Refresh token opaco: o cliente recebe o valor aleatório, o banco guarda só o
// SHA-256. Cada uso marca usado_em e gera outro (rotação); um token já usado que
// reaparece indica roubo e revoga todos os tokens do usuário.
model RefreshToken {
  id         String    @id @default(uuid(7)) @db.Char(36)
  usuarioId  String    @map("usuario_id") @db.Char(36)
  tokenHash  String    @unique @map("token_hash") @db.Char(64)
  expiraEm   DateTime  @map("expira_em")
  usadoEm    DateTime? @map("usado_em")
  revogadoEm DateTime? @map("revogado_em")
  criadoEm   DateTime  @default(now()) @map("criado_em")

  usuario Usuario @relation(fields: [usuarioId], references: [id], onDelete: Cascade)

  @@map("refresh_tokens")
}
